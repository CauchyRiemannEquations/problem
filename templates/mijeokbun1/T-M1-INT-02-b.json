    },
    {
      "expr": "6*a*q + 2*b",
      "mistake_type": "generic: 적분하지 않고 f'({q})를 계산"
    },
    {
      "expr": "v",
      "mistake_type": "generic: 주어진 함수값을 그대로 답함"
    }
