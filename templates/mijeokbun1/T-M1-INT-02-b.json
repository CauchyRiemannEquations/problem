  "difficulty": 2,
  "problem_format": "mcq5",
  "stem_latex": "\\text{함수 } f(x) \\text{ 에 대하여 } f'(x) = {6*a}x + {2*b} \\text{ 이고 } f({p}) = {v} \\text{ 일 때, } f({q}) \\text{ 의 값은?}",
  "params": [
