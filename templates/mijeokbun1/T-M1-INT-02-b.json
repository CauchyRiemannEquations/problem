    { "name": "q", "type": "int", "range": [-3, 3] },
    { "name": "v", "type": "int", "range": [-6, 6], "exclude": [0] }
  ],
  "constraints": [
    "q != p",
    "3*a*p + 2*b != 0",
    "3*a*p^2 + 2*b*p != 0"
  ],
  "answer_expr": "3*a*q^2 + 2*b*q + v - 3*a*p^2 - 2*b*p",
  "distractors": [
    {
      "expr": "3*a*q^2 + 2*b*q",
      "mistake_type": "C를 여러 개 붙이거나 아예 생략한다 → 조건 f({p})={v}를 사용하지 않음"
