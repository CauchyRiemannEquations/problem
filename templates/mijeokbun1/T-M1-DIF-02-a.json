  "problem_format": "mcq5",
  "stem_latex": "f(x) = x^2 + {b}x \\text{ 일 때, } \\lim_{h \\to 0} \\dfrac{f({p} + {a}h) - f({p})}{h} \\text{ 의 값은?}",
  "params": [
    { "name": "b", "type": "int", "range": [-4, 4], "exclude": [0] },
    { "name": "p", "type": "int", "range": [-3, 3], "exclude": [0] },
    { "name": "a", "type": "int", "range": [-3, 3], "exclude": [0, 1] }
  ],
  "constraints": [
    "2*p + b != 0"
  ],
  "answer_expr": "a*(2*p + b)",
  "distractors": [
    {
      "expr": "2*p + b",
      "mistake_type": "미분계수와 도함수를 구분하지 못한다 → 분자의 h 계수를 무시하고 f'({p})만 답함"
    },
    {
      "expr": "0",
      "mistake_type": "h를 약분하기 전에 h=0을 대입한다 → 0/0을 0으로 답함"
    },
    {
      "expr": "2*a*p + b",
      "mistake_type": "f(a+h)를 계산할 때 괄호를 빼먹는다 → 일차항에는 계수를 곱하지 않음"
    },
    {
      "expr": "-(a*(2*p + b))",
      "mistake_type": "generic: 부호 실수"
    }
  ],
  "source_mistakes": [
    "미분계수와 도함수를 구분하지 못한다.",
    "h를 약분하기 전에 h=0을 대입한다.",
    "f(a+h)를 계산할 때 괄호를 빼먹는다."
  ],
  "needs_figure": false,
  "curriculum_check": "미분계수의 정의 lim (f(a+h)-f(a))/h 의 변형식 계산은 미적분Ⅰ '미분계수' 대표 유형이며 이차함수만 사용한다."
