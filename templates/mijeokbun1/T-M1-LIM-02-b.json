  "unit": "함수의 극한과 연속",
  "title": "좌극한과 우극한 - 그래프에서 한쪽 극한 읽기",
  "difficulty": 2,
  "problem_format": "mcq5",
  "stem_latex": "\\text{그림은 함수 } y = f(x) \\text{ 의 그래프이다. } \\lim_{x \\to {p}^{-}} f(x) + \\lim_{x \\to {p}^{+}} f(x) \\text{ 의 값은?}",
  "params": [
    { "name": "a", "type": "int", "range": [-4, 4], "exclude": [0] },
    { "name": "b", "type": "choice", "choices": [-2, -1, 1, 2] },
    { "name": "c", "type": "int", "range": [-4, 4] },
    { "name": "p", "type": "int", "range": [-2, 2], "exclude": [0] }
  ],
  "constraints": [
    "p + a != b*p + c",
    "p + a != 0",
    "b*p + c != 0",
    "abs((p + a) - (b*p + c)) >= 2",
    "b*p + c != 3*(p + a)",
    "b*p + c != -(p + a)"
  ],
  "answer_expr": "(p + a) + (b*p + c)",
  "distractors": [
    {
      "expr": "2*(p + a)",
      "mistake_type": "한쪽 값만 보고 극한값이 있다고 판단한다 → 좌극한 값을 양쪽 극한으로 사용"
    },
    {
      "expr": "2*(b*p + c)",
      "mistake_type": "그래프에서 열린 점과 닫힌 점만 보고 좌우 흐름을 보지 않는다 → 닫힌 점의 값을 양쪽 극한으로 사용"
    },
    {
      "expr": "(b*p + c) - (p + a)",
      "mistake_type": "generic: 합 대신 차를 계산"
    },
    {
      "expr": "p + a",
      "mistake_type": "generic: 좌극한만 계산하고 우극한을 누락"
    }
  ],
  "source_mistakes": [
    "한쪽 값만 보고 극한값이 있다고 판단한다.",
    "그래프에서 열린 점과 닫힌 점만 보고 좌우 흐름을 보지 않는다."
  ],
