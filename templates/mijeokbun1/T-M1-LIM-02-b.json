      { "kind": "segment", "from": ["p", "b*p + c"], "to": ["0", "b*p + c"], "dashed": true },
      { "kind": "point", "at": ["p", "p + a"], "open": true },
      { "kind": "point", "at": ["p", "b*p + c"] },
      { "kind": "xtick", "at": "p" },
      { "kind": "ytick", "at": "p + a" },
      { "kind": "ytick", "at": "b*p + c" },
      { "kind": "label", "at": ["min(p, 0) - 2.1", "max(max(p + a, b*p + c), 0) + 1.2"], "text": "y = f(x)" }
