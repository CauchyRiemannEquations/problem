{
  "name": "bamsam-problem-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "밤샘 문제공장 — 개념카드 기반 파라메트릭 문제 생성 파이프라인 v0.1",
  "scripts": {
    "factory:gen": "tsx src/generate.ts",
    "factory:selftest": "tsx src/selftest.ts",
    "factory:review": "tsx src/review.ts",
    "factory:html": "tsx src/render_html.ts",
    "factory:embed": "tsx scripts/embed_templates.ts",
    "factory:app": "npm run factory:embed && tsx src/app.ts",
    "build:bundle": "npm run factory:embed && esbuild src/app.ts --bundle --platform=node --format=cjs \"--define:PACKAGE_VERSION='3.2.1'\" --outfile=dist/app.cjs"
  },
  "dependencies": {
    "mathjax-full": "^3.2.1",
    "mathjs": "^13.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}